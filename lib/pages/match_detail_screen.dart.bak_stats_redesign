      {List<LocalLineupPlayer> allPlayers = const []}) {
    Color ratingBg;
    if (player.rating >= 8.0)
      ratingBg = const Color(0xFF1B5E20);
    else if (player.rating >= 7.0)
      ratingBg = const Color(0xFF388E3C);
    else if (player.rating >= 6.5)
