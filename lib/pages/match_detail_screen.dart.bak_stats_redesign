  // Campo generale — percentuali combinate entrambe le squadre
  Widget _generalFieldHeatmap(
      int leftPct, int centerPct, int rightPct, bool isDark) {
    final maxPct =
        [leftPct, centerPct, rightPct].reduce((a, b) => a > b ? a : b);
    double zoneOpacity(int val) => 0.22 + (val / maxPct) * 0.42;

    return AspectRatio(
      aspectRatio: 1.5,
      child: ClipRRect(
        borderRadius: BorderRadius.circular(12),
        child: Stack(children: [
          // Zone sfumate
          Row(children: [
            Expanded(
                child: Container(
                    decoration: BoxDecoration(
                        gradient: LinearGradient(
              begin: Alignment.topCenter,
              end: Alignment.bottomCenter,
              colors: [
                const Color(0xFFD4B84A).withOpacity(zoneOpacity(leftPct)),
                const Color(0xFFCAAD3F).withOpacity(zoneOpacity(leftPct) - 0.06)
              ],
            )))),
            Expanded(
                child: Container(
                    decoration: BoxDecoration(
                        gradient: LinearGradient(
              begin: Alignment.topCenter,
              end: Alignment.bottomCenter,
              colors: [
                const Color(0xFFD4A020).withOpacity(zoneOpacity(centerPct)),
                const Color(0xFFCB9818)
                    .withOpacity(zoneOpacity(centerPct) + 0.04)
              ],
            )))),
            Expanded(
                child: Container(
                    decoration: BoxDecoration(
                        gradient: LinearGradient(
              begin: Alignment.topCenter,
              end: Alignment.bottomCenter,
              colors: [
                const Color(0xFFD4B84A).withOpacity(zoneOpacity(rightPct)),
                const Color(0xFFCAAD3F)
                    .withOpacity(zoneOpacity(rightPct) - 0.06)
              ],
            )))),
          ]),
          // Linee campo
          CustomPaint(
              painter: _PassFieldLinePainter(isDark: isDark),
              size: Size.infinite),
          // Badge percentuali (non tappabili in vista generale)
          Row(children: [
            Expanded(child: Center(child: _generalZoneBadge('$leftPct%'))),
            Expanded(child: Center(child: _generalZoneBadge('$centerPct%'))),
            Expanded(child: Center(child: _generalZoneBadge('$rightPct%'))),
          ]),
        ]),
      ),
    );
  }

