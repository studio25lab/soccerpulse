                TextButton(
                  onPressed: () {
                    setSheetState(() {});
                    setState(() => _activeEventFilters = {
                          'goal',
                          'yellowCard',
                          'redCard',
                          'substitution'
                        });
                    setSheetState(() {});
                  },
                  child: Text('Solo chiave',
                      style: TextStyle(fontSize: 12, color: lb)),
                ),
                const SizedBox(width: 4),
                TextButton(
                  onPressed: () {
                    setSheetState(() {});
                    setState(() => _activeEventFilters = {
                          'goal',
                          'yellowCard',
